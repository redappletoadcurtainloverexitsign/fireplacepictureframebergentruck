rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'gecko@nova-games.local';
    }
    match /users/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.deleted == false;
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin', 'signInCount']));
      allow delete: if isAdmin();
    }
    match /config/site {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
